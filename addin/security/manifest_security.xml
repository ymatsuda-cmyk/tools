<?xml version="1.0" encoding="UTF-8"?>
<!-- 公開先：https://ymatsuda-cmyk.github.io/tools/addin/security/ -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>cf7c379f-305f-4ccc-a8fc-c5afad445dde</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>JapanBusinessAssist</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="セキュリティ"/>
  <Description DefaultValue="情報漏洩対策集（Webページ）のJSONを読み込み、対策一覧・対象判定・点検結果・サマリをExcelに保存します。Excelで入力した結果をJSONに戻すこともできます。"/>
  <IconUrl DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/"/>
  <AppDomains>
    <AppDomain>ymatsuda-cmyk.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.8"/>
      <!-- 共有ランタイム：Excel起動時（ブックを開いた時）の自動読み込みに必要 -->
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!-- 共有ランタイム：作業ウィンドウを閉じてもランタイムを維持する -->
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <DesktopFormFactor>
          <!-- 共有ランタイムでは作業ウィンドウと同じURLを指定する -->
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="LeakMeasures.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="LeakMeasures.Open">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>LeakMeasures.Pane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://ymatsuda-cmyk.github.io/tools/addin/security/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="セキュリティ"/>
        <bt:String id="Button.Label" DefaultValue="点検"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="情報漏洩対策集のデータをExcelに保存・更新し、Excelで入力した点検結果をJSONに書き出します。"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
